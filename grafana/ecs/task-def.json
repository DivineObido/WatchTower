{
    "family": "grafana-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::288761756960:role/ecsExecutionRole",
    "containerDefinitions": [
        {
            "name": "grafana",
            "image": "grafana/grafana:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                { "name": "GF_LOG_MODE", "value": "console" },
                { "name": "GF_SECURITY_ADMIN_USER", "value": "admin" },
                { "name": "GF_SECURITY_ADMIN_PASSWORD", "value": "admin" },
                { "name": "GF_SERVER_HTTP_ADDR", "value": "0.0.0.0" }
            ],

            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-create-group": "true",
                    "awslogs-group": "/ecs/grafana-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "grafana"
                }
            }
        }
    ]
}