{
    "family": "watchTower-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::288761756960:role/ecsExecutionRole",
    "containerDefinitions": [
        {
            "name": "watchtower-container",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:latest",
            "essential": true,
            "memory": 512,
            "cpu": 256,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ], 

            "environment": [
                {
                    "name": "PORT",
                    "value": "80"
                },
                {
                    "name": "PRODUCT_CATALOG_SERVICE_ADDR",
                    "value": "productcatalogservice:3550"
                },
                {
                    "name": "CURRENCY_SERVICE_ADDR",
                    "value": "currencyservice:7000"
                },
                {
                    "name": "CART_SERVICE_ADDR",
                    "value": "cartservice:7070"
                },
                {
                    "name": "RECOMMENDATION_SERVICE_ADDR",
                    "value": "recommendationservice:8080"
                },
                {
                    "name": "SHIPPING_SERVICE_ADDR",
                    "value": "shippingservice:50051"
                },
                {
                    "name": "CHECKOUT_SERVICE_ADDR",
                    "value": "checkoutservice:5050"
                },
                {
                    "name": "SHOPPING_ASSISTANT_SERVICE_ADDR",
                    "value": "shoppingassistantservice:8081"
                },
                {
                    "name": "EMAIL_SERVICE_ADDR",
                    "value": "emailservice:8080"
                },
                {
                    "name": "AD_SERVICE_ADDR",
                    "value": "adservice:9555"
                },
                {
                    "name": "PAYMENT_SERVICE_ADDR",
                    "value": "paymentservice:5000"
                }
            ], 
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}