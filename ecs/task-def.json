{
    "family": "watchTower-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::288761756960:role/ecsExecutionRole",
    "containerDefinitions": [
        {
            "name": "watchtower-container",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:latest",
            "essential": true,
            "memory": 512,
            "cpu": 256,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ], 

            "environment": [
                {
                    "name": "PORT",
                    "value": "80"
                }
            ], 
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}