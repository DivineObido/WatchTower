{
    "family": "watchTower-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::288761756960:role/ecsExecutionRole",
    "containerDefinitions": [
        {
            "name": "frontend",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:frontend-latest",
            "essential": true,
            "portMappings": [{"containerPort": 8080, "protocol": "tcp"}], 
            "environment": [
                {"name": "EMAIL_SERVICE_ADDR", "value": "localhost:8081"},
                {"name": "SHOPPING_ASSISTANT_SERVICE_ADDR", "value": "localhost:8082"},
                {"name": "CHECKOUT_SERVICE_ADDR", "value": "localhost:5050"},
                {"name": "SHIPPING_SERVICE_ADDR", "value": "localhost:50051"},
                {"name": "RECOMMENDATION_SERVICE_ADDR", "value": "localhost:8083"},
                {"name": "CART_SERVICE_ADDR", "value": "localhost:7070"},
                {"name": "CURRENCY_SERVICE_ADDR", "value": "localhost:7000"},
                {"name": "PRODUCT_CATALOG_SERVICE_ADDR", "value": "localhost:3550"},
                {"name": "PAYMENT_SERVICE_ADDR", "value": "localhost:5000"},
                {"name": "AD_SERVICE_ADDR", "value": "localhost:9555"},
                {"name": "DISABLE_PROFILER", "value": "1"}
            ], 
            
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "frontend"
                }
            }
        },
        {
          "name": "emailservice",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:email-latest",
            "essential": true,
            "portMappings": [{"containerPort": 8081, "protocol": "tcp"}],  
            "environment": [{"name": "DISABLE_PROFILER", "value": "1"}],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "email"
                }
            }
        },
        {
          "name": "checkoutservice",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:checkout-latest",
            "essential": true,
            "portMappings": [{"containerPort": 5050, "protocol": "tcp"}],
            "environment": [
                {"name": "PRODUCT_CATALOG_SERVICE_ADDR", "value": "localhost:3550"},
                {"name": "SHIPPING_SERVICE_ADDR", "value": "localhost:50051"},
                {"name": "EMAIL_SERVICE_ADDR", "value": "localhost:8081"},
                {"name": "PAYMENT_SERVICE_ADDR", "value": "localhost:5000"},
                {"name": "CURRENCY_SERVICE_ADDR", "value": "localhost:7000"},
                {"name": "CART_SERVICE_ADDR", "value": "localhost:7070"},
                {"name": "DISABLE_PROFILER", "value": "1"}
            ],
             "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "checkout"
                }
            }
        }, 
        {
          "name": "shippingservice",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:shipping-latest",
            "essential": true,
            "portMappings": [{"containerPort": 50051, "protocol": "tcp"}],
            "environment": [{"name": "DISABLE_PROFILER", "value": "1"}],
             "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "shipping"
                }
            }
        }, 
        {
          "name": "recommendationservice",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:recommendation-latest",
            "essential": true,
            "portMappings": [{"containerPort": 8083, "protocol": "tcp"}],
            "environment" : [
                {"name": "PRODUCT_CATALOG_SERVICE_ADDR", "value": "localhost:3550"},
                {"name": "DISABLE_PROFILER", "value": "1"}
            ],
             "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "recommendation"
                }
            }
        },
        {
          "name": "cartservice",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:cart-latest",
            "essential": true,
            "portMappings": [{"containerPort": 7070, "protocol": "tcp"}],
            "environment": [{"name": "DISABLE_PROFILER", "value": "1"}],
             "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "cart"
                }
            }
        },
        {
          "name": "currencyservice",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:currency-latest",
            "essential": true,
            "portMappings": [{"containerPort": 7000, "protocol": "tcp"}],
            "environment": [
                {"name": "PORT", "value": "7000"},
                {"name": "DISABLE_PROFILER", "value": "1"}
            ],
             "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "currency"
                }
            }
        },
        {
          "name": "productcatalogservice",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:product-latest",
            "essential": true,
            "portMappings": [{"containerPort": 3550, "protocol": "tcp"}],
            "environment": [{"name": "DISABLE_PROFILER", "value": "1"}],
             "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "product"
                }
            }
        },
        {
          "name": "paymentservice",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:payment-latest",
            "essential": true,
            "portMappings": [{"containerPort": 5000, "protocol": "tcp"}],
            "environment":[
                {"name": "PORT", "value": "5000"},
                {"name": "DISABLE_PROFILER", "value": "1"}
            ],
             "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "payment"
                }
            }
        },
        {
          "name": "prometheus",
            "image": "288761756960.dkr.ecr.us-east-1.amazonaws.com/watchtower-repo:prometheus-latest",
            "essential": false,
            "portMappings": [{"containerPort": 9090, "protocol": "tcp"}],
            "environment":[],
             "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watchTower-log-group",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "prometheus"
                }
            }
        }
    ]
}